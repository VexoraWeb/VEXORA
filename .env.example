# --- E-mail (Resend) ---------------------------------------------------------
# Clé API créée sur https://resend.com/api-keys (ne JAMAIS la committer)
RESEND_API_KEY=

# Adresse qui reçoit toutes les demandes (devis, audits, contact)
CONTACT_EMAIL=600secu@proton.me

# Expéditeur. Tant que votre domaine n'est pas vérifié chez Resend, utilisez
# l'adresse de test ci-dessous (Resend n'envoie alors qu'à l'e-mail du compte Resend).
# Avec un domaine vérifié : "VEXORA_STUDIO <contact@votre-domaine.fr>"
RESEND_FROM_EMAIL=VEXORA_STUDIO <onboarding@resend.dev>

# URL publique du site (optionnel, utilisée pour les métadonnées)
NEXT_PUBLIC_SITE_URL=
